{
  "presets": [
    ["@babel/preset-env", {
      "modules": false,
      "targets": {
        "browsers": ["> 1%", "last 10 versions", "not ie <= 11"]
      }
    }],
    ["@babel/preset-typescript", {
      "allExtensions": true,
      "isTSX": true
    }],
    ["@vue/babel-preset-jsx", { "injectH": false }]
  ],
  "plugins": ["@babel/plugin-transform-runtime"],
  "env": {
    "test": {
      "presets": ["@babel/preset-env"],
      "plugins": ["istanbul"]
    }
  }
}
